@model codArd.Models.ViewModels.TaskViewModel
@{
}

<section>

<form asp-controller="Task" asp-action="AddTask">
    <input name="TaskName" />
    <input name="TaskDescription"/>
    <input type="submit" />
        <select name="TopicId">
            @foreach (var item in Model.topicViewModel)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
</form>
    
</section>
<section>
    @foreach(var item in Model.tasksViewModel)
    {
        <div>
        <h2>@item.TaskName</h2>
        <p>@item.Description</p>
        <a class="btn btn-danger" asp-controller="Task" asp-action="DeleteTask" asp-route-id="@item.Id">Delete?</a>
        <a class="btn btn-secondary" asp-controller="Task" asp-action="Edit" asp-route-id="@item.Id">Edit</a>     
    </div>

    }


</section>
